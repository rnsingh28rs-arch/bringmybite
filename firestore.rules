rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Central D-Admin CMS Configuration (Web, Android & iOS live synchronized)
    // Public read so all apps and web customers get instant zero-downtime updates without re-compiling.
    match /configs/{configId} {
      allow read: if true;
      allow write: if isValidId(configId);
    }

    // Subscriptions collection
    match /subscriptions/{subscriptionId} {
      allow read: if true;
      allow create: if isValidId(subscriptionId);
      allow update, delete: if isValidId(subscriptionId);
    }

    // Instant Thali Orders collection
    match /instant_orders/{orderId} {
      allow read: if true;
      allow create: if isValidId(orderId);
      allow update, delete: if isValidId(orderId);
    }

    // Receipts & Invoices collection
    match /receipts/{receiptId} {
      allow read: if true;
      allow create, update, delete: if isValidId(receiptId);
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
